{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "records.schema.json#/$defs/Task"
    },
    {
      "$ref": "records.schema.json#/$defs/Specification"
    },
    {
      "$ref": "records.schema.json#/$defs/SourceInventory"
    },
    {
      "$ref": "records.schema.json#/$defs/PhaseRecord"
    },
    {
      "$ref": "records.schema.json#/$defs/Operation"
    },
    {
      "$ref": "records.schema.json#/$defs/Installation"
    },
    {
      "$ref": "records.schema.json#/$defs/Update"
    }
  ],
  "$defs": {
    "Task": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "record_type": {
          "const": "Task"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "$ref": "common.schema.json#/$defs/Evidence"
        },
        "configuration": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "bundle": {
              "$ref": "common.schema.json#/$defs/ContentIdentity"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "identity": {
                    "$ref": "common.schema.json#/$defs/ContentIdentity"
                  }
                },
                "required": [
                  "path",
                  "identity"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "id",
            "bundle",
            "files"
          ],
          "additionalProperties": false
        },
        "source_scope": {
          "$ref": "common.schema.json#/$defs/SourceScope"
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "task_id",
        "request",
        "configuration"
      ],
      "additionalProperties": false
    },
    "Specification": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "record_type": {
          "const": "Specification"
        },
        "document": {
          "$ref": "common.schema.json#/$defs/Evidence"
        },
        "acceptance": {
          "type": "object",
          "properties": {
            "authority": {
              "$ref": "common.schema.json#/$defs/Evidence"
            },
            "review": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "authority",
            "review"
          ],
          "additionalProperties": false
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "methods": {
                "type": "array",
                "items": {
                  "enum": [
                    "REVIEW",
                    "EXECUTION"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "description",
              "required",
              "methods"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "source_scope": {
          "$ref": "common.schema.json#/$defs/SourceScope"
        },
        "reconcile_skips": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "human_review": {
          "$ref": "#/$defs/HumanReview"
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "document",
        "acceptance",
        "criteria",
        "source_scope",
        "reconcile_skips"
      ],
      "additionalProperties": false
    },
    "SourceInventory": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "record_type": {
          "const": "SourceInventory"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "common.schema.json#/$defs/ContentIdentity"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/SourceScope"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "identity": {
                "$ref": "common.schema.json#/$defs/ContentIdentity"
              }
            },
            "required": [
              "path",
              "identity"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "task_id",
        "revision",
        "scope",
        "files"
      ],
      "additionalProperties": false
    },
    "PhaseRecord": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "record_type": {
          "const": "PhaseRecord"
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "IN_PROGRESS",
            "PASS",
            "FAIL",
            "BLOCKED",
            "UNKNOWN",
            "USER_SKIPPED"
          ]
        },
        "specification": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Evidence"
          },
          "minItems": 0
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion_id": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "UNKNOWN"
                ]
              },
              "method": {
                "enum": [
                  "REVIEW",
                  "EXECUTION"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/Evidence"
                },
                "minItems": 1
              },
              "operation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "criterion_id",
              "result",
              "method",
              "reason",
              "evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "approval": {
          "$ref": "common.schema.json#/$defs/Approval"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "retry_of": {
          "type": "string",
          "minLength": 1
        },
        "human_review": {
          "$ref": "#/$defs/HumanReview"
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "phase",
        "status",
        "specification",
        "source",
        "summary",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "record_type": {
          "const": "Operation"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "INTENT",
            "RUNNING",
            "COMPLETED",
            "CANCELLED",
            "UNKNOWN"
          ]
        },
        "specification": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "common.schema.json#/$defs/ContentIdentity"
        },
        "connection": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            },
            "environment": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "$ref": "common.schema.json#/$defs/Evidence"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "handle": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "UNKNOWN"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Evidence"
          },
          "minItems": 0
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000]*$"
          },
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "operation_id",
        "phase",
        "status",
        "specification",
        "source",
        "connection",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Installation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "record_type": {
          "const": "Installation"
        },
        "kit_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PENDING",
            "CHECKED"
          ]
        },
        "activation": {
          "enum": [
            "PENDING",
            "CONFIRMED"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Check"
          },
          "minItems": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "kit_version",
        "configuration_id",
        "status",
        "activation",
        "created_at",
        "files",
        "checks"
      ],
      "additionalProperties": false
    },
    "Update": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "record_type": {
          "const": "Update"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "type": "string",
          "minLength": 1
        },
        "base_configuration": {
          "type": "string",
          "minLength": 1
        },
        "candidate_configuration": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "INSPECTING",
            "STAGED",
            "CHECKED",
            "PUBLISHED",
            "BLOCKED",
            "FAILED"
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "$ref": "common.schema.json#/$defs/ContentIdentity"
              },
              "after": {
                "$ref": "common.schema.json#/$defs/ContentIdentity"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Check"
          },
          "minItems": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "recovery": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "id",
        "request",
        "base_configuration",
        "candidate_configuration",
        "status",
        "changes",
        "checks"
      ],
      "additionalProperties": false
    },
    "SourceScope": {
      "type": "object",
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "roots",
        "exclude"
      ],
      "additionalProperties": false
    },
    "Check": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "PENDING"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "adapter": {
          "enum": [
            "research",
            "pattern_search",
            "specification",
            "verification_plan",
            "implementation_plan",
            "implementation",
            "preflight",
            "build",
            "test",
            "specification_verification",
            "final_review"
          ]
        },
        "connection": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "method": {
          "enum": [
            "REVIEW",
            "EXECUTION"
          ]
        },
        "observations": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "execution": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "exit_code": {
              "type": "integer"
            },
            "output": {
              "type": "string"
            }
          },
          "required": [
            "command",
            "exit_code",
            "output"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "result",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "adapter"
                ]
              },
              {
                "required": [
                  "connection"
                ]
              },
              {
                "required": [
                  "method"
                ]
              },
              {
                "required": [
                  "observations"
                ]
              },
              {
                "required": [
                  "execution"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "adapter",
              "connection",
              "method",
              "observations"
            ]
          }
        },
        {
          "if": {
            "required": [
              "method"
            ],
            "properties": {
              "method": {
                "const": "EXECUTION"
              }
            }
          },
          "then": {
            "required": [
              "execution"
            ]
          },
          "else": {
            "not": {
              "required": [
                "execution"
              ]
            }
          }
        }
      ]
    },
    "HumanReview": {
      "type": "object",
      "properties": {
        "record": {
          "type": "string",
          "pattern": "^e[0-9]{6,}$"
        },
        "approval": {
          "$ref": "common.schema.json#/$defs/Approval"
        }
      },
      "required": [
        "record",
        "approval"
      ],
      "additionalProperties": false
    }
  }
}
