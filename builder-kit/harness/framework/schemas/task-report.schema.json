{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "report_version": {
      "const": "2.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "generation_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "context_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "IN_PROGRESS",
        "BLOCKED",
        "UNVERIFIED"
      ]
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "open_operations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "specification": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "report_version",
    "task_id",
    "generation_id",
    "context_id",
    "status",
    "phases",
    "criteria",
    "issues",
    "history",
    "inputs",
    "limitations",
    "generated_at",
    "open_operations"
  ],
  "additionalProperties": false
}
