{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "record_type": {
      "const": "Workflow"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "proof": {
            "enum": [
              "REVIEW",
              "EXECUTION"
            ]
          },
          "mandatory": {
            "type": "boolean"
          },
          "source_sensitive": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "phases"
  ],
  "additionalProperties": false
}
